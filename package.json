{
  "name": "dsh-sick-fatfish",
  "version": "0.1.0",
  "description": "给 DeepSeek Harness 的「生病的肥鱼」：一个会话同时得 1~5 个病（等级决定数量、病随机抽），靠使用者关心才会慢慢好；长期慢性病最多到慢性稳定。默认非全局、按会话开关、可随时关掉。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "src",
    "client.js",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/panel.js && node --check src/engine.js && node --check src/data.js && node --check client.js",
    "test": "node test/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sick-fatfish",
    "care"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0-rc.2"
  }
}
